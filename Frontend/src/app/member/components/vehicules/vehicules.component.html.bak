<div class="p-4">

  <!-- Header -->
  <div class="d-flex align-items-center gap-3 mb-4">
    <div class="bg-info bg-opacity-10 p-3 rounded-3">
      <i class="bi bi-car-front-fill text-info fs-2"></i>
      <!-- ======= APPELER LE VÉHICULE ======= -->

  <!-- Status Alert -->
  <div *ngIf="statusMessage" class="alert alert-info d-flex align-items-center gap-2 mt-4">
    <div class="spinner-border spinner-border-sm" *ngIf="carCalled"></div>
    <i class="bi bi-info-circle-fill" *ngIf="!carCalled"></i>
    {{ statusMessage }}
  </div>

  <!-- Map -->
  <div class="card border-0 shadow-sm mt-4">
    <div class="card-body p-0">
      <div id="map" style="height: 450px; border-radius: 12px;"></div>
    </div>
  </div>

  <!-- IoT Info -->
  <div class="row g-3 mt-3" *ngIf="iotData">
    <div class="col-md-3">
      <div class="card border-0 shadow-sm border-start border-success border-4">
        <div class="card-body py-2">
          <p class="text-muted small mb-0">Vitesse</p>
          <h5 class="fw-bold mb-0 text-success">{{ iotData.speed }} km/h</h5>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm border-start border-warning border-4">
        <div class="card-body py-2">
          <p class="text-muted small mb-0">Batterie</p>
          <h5 class="fw-bold mb-0 text-warning">{{ iotData.battery }}%</h5>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm border-start border-info border-4">
        <div class="card-body py-2">
          <p class="text-muted small mb-0">Température</p>
          <h5 class="fw-bold mb-0 text-info">{{ iotData.temperature }}°C</h5>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm border-start border-danger border-4">
        <div class="card-body py-2">
          <p class="text-muted small mb-0">Obstacle</p>
          <h5 class="fw-bold mb-0 text-danger">{{ iotData.obstacle ? 'Détecté' : 'Aucun' }}</h5>
        </div>
      </div>
    </div>
  </div>

  <!-- Buttons -->
  <div class="d-flex gap-3 mt-4">
    <button class="btn btn-success btn-lg px-5" (click)="callCar()" [disabled]="carCalled">
      <i class="bi bi-geo-alt-fill me-2"></i>
      Appeler le véhicule
    </button>
    <button class="btn btn-outline-danger btn-lg px-4" (click)="cancelCar()" *ngIf="carCalled">
      <i class="bi bi-x-circle me-2"></i>
      Annuler
    </button>
  </div>

</div>
    <div>
      <h3 class="fw-bold mb-0"> Véhicules</h3>
      <p class="text-muted mb-0">{{ vehicles.length }} véhicule(s) enregistré(s)</p>
      <!-- ======= APPELER LE VÉHICULE ======= -->

  <!-- Status Alert -->
  <div *ngIf="statusMessage" class="alert alert-info d-flex align-items-center gap-2 mt-4">
    <div class="spinner-border spinner-border-sm" *ngIf="carCalled"></div>
    <i class="bi bi-info-circle-fill" *ngIf="!carCalled"></i>
    {{ statusMessage }}
  </div>

  <!-- Map -->
  <div class="card border-0 shadow-sm mt-4">
    <div class="card-body p-0">
      <div id="map" style="height: 450px; border-radius: 12px;"></div>
    </div>
  </div>

  <!-- IoT Info -->
  <div class="row g-3 mt-3" *ngIf="iotData">
    <div class="col-md-3">
      <div class="card border-0 shadow-sm border-start border-success border-4">
        <div class="card-body py-2">
          <p class="text-muted small mb-0">Vitesse</p>
          <h5 class="fw-bold mb-0 text-success">{{ iotData.speed }} km/h</h5>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm border-start border-warning border-4">
        <div class="card-body py-2">
          <p class="text-muted small mb-0">Batterie</p>
          <h5 class="fw-bold mb-0 text-warning">{{ iotData.battery }}%</h5>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm border-start border-info border-4">
        <div class="card-body py-2">
          <p class="text-muted small mb-0">Température</p>
          <h5 class="fw-bold mb-0 text-info">{{ iotData.temperature }}°C</h5>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm border-start border-danger border-4">
        <div class="card-body py-2">
          <p class="text-muted small mb-0">Obstacle</p>
          <h5 class="fw-bold mb-0 text-danger">{{ iotData.obstacle ? 'Détecté' : 'Aucun' }}</h5>
        </div>
      </div>
    </div>
  </div>

  <!-- Buttons -->
  <div class="d-flex gap-3 mt-4">
    <button class="btn btn-success btn-lg px-5" (click)="callCar()" [disabled]="carCalled">
      <i class="bi bi-geo-alt-fill me-2"></i>
      Appeler le véhicule
    </button>
    <button class="btn btn-outline-danger btn-lg px-4" (click)="cancelCar()" *ngIf="carCalled">
      <i class="bi bi-x-circle me-2"></i>
      Annuler
    </button>
  </div>

</div>
