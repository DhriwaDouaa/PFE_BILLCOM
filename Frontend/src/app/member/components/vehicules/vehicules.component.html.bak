          <div class="d-flex justify-content-between align-items-center border-top pt-3">
            <span class="badge"
                  [class.bg-success]="v.status === 'ACTIVE'"
                  [class.bg-danger]="v.status !== 'ACTIVE'">
              <i class="bi me-1"
                 [class.bi-check-circle]="v.status === 'ACTIVE'"
                 [class.bi-x-circle]="v.status !== 'ACTIVE'"></i>
              {{ v.status === 'ACTIVE' ? 'Actif' : 'Inactif' }}
            </span>
            <small class="text-muted">
              <i class="bi bi-shield-check me-1 text-info"></i>
              IoT Connecté
            </small>
