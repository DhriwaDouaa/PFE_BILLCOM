            <li class="mb-2">
              <i class="bi bi-calendar3 text-muted me-2"></i>
              Année <strong>{{ v.year }}</strong>
            </li>
            <li class="mb-2">
              <i class="bi bi-palette-fill text-muted me-2"></i>
